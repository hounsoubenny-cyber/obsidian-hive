# ── /home/devops ───────────────────────────────────────────────────────────
RUN mkdir -p /home/devops/.ssh /home/devops/.config /home/devops/projects /home/devops/scripts \
    && chmod 700 /home/devops/.ssh && \
    cat > /home/devops/.ssh/config << 'SSHCFGEOF'
