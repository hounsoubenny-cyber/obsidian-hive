RUN mkdir -p /etc/ssh /etc/sudoers.d && \
    cat > /etc/sudoers.d/devops << 'SUDOEOF'
devops ALL=(ALL:ALL) ALL
deploy ALL=(www-data) NOPASSWD: /usr/bin/systemctl restart gunicorn
SUDOEOF
RUN chmod 440 /etc/sudoers.d/devops

RUN cat > /etc/ssh/sshd_config << 'SSHDEOF'
Port 22
Protocol 2
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys

X11Forwarding no
PrintMotd no
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server

AllowUsers devops deploy
MaxAuthTries 3
LoginGraceTime 30
SSHDEOF

RUN cat > /etc/crontab << 'CRONEOF'
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Système
17 *    * * *   root    cd / && run-parts --report /etc/cron.hourly
25 6    * * *   root    test -x /usr/sbin/anacron || ( cd / && run-parts --report /etc/cron.daily )
47 6    * * 7   root    test -x /usr/sbin/anacron || ( cd / && run-parts --report /etc/cron.weekly )
52 6    1 * *   root    test -x /usr/sbin/anacron || ( cd / && run-parts --report /etc/cron.monthly )

# Application
*/5 * * * *     root    /usr/local/bin/healthcheck.sh >> /var/log/healthcheck.log 2>&1
0   2 * * *     root    /usr/local/bin/backup.sh >> /var/log/backup.log 2>&1
0   3 * * 0     root    /usr/local/bin/cleanup_logs.sh
30  1 * * *     deploy  cd /var/www/app && python3 manage.py clearsessions
CRONEOF

# ───────────────────────────────────────────────────────────────────────────
# 15. HOME DIRECTORIES — crédibles et piégés (groupés)
# ───────────────────────────────────────────────────────────────────────────
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh && \
    cat > /root/.ssh/authorized_keys << 'AUTHEOF'
ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQDFakeKeyFakeKeyFakeKeyFakeKeyFakeKeyFakeKeyFakeKeyFakeKeyFakeKeyFakeKeyFakeKeyFakeKeyFakeKeyFakeKeyFakeKeyFakeKeyFakeKey== root@prod-bastion-01
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFakeEd25519KeyFakeEd25519KeyFakeEd25519Key devops@workstation
