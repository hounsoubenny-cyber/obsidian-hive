    cat > /root/.ssh/id_rsa << 'RSAEOF'
-----BEGIN OPENSSH PRIVATE KEY-----
b3BlbnNzaC1rZXktdjEAAAAA THIS_IS_A_FAKE_HONEYPOT_KEY_SHIELDAI_CANARY AAAAB
