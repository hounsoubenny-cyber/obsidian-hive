RUN echo "prod-web-01" > /etc/hostname && \
    cat > /etc/hosts << 'HOSTSEOF'
127.0.0.1       localhost
127.0.1.1       prod-web-01
::1             localhost ip6-localhost ip6-loopback
ff02::1         ip6-allnodes
ff02::2         ip6-allrouters

# Infrastructure interne
10.0.1.10       prod-web-01   prod-web-01.internal
10.0.1.11       prod-web-02   prod-web-02.internal
10.0.1.1        gateway       internal-gateway

# Base de données
10.0.2.10       db-primary    db-primary.internal   mysql.internal
10.0.2.11       db-replica    db-replica.internal
