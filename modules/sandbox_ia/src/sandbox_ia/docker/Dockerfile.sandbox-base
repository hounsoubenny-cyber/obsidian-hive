# ═══════════════════════════════════════════════════════════════════════════
#  ShieldAI V2 — Sandbox Base Image
#  Environnement d'exécution isolé avec système crédible (honeypot layer)
#  Langages : Python, Node.js, PHP, Ruby, Perl, Java, Go, Rust, Lua, R, C/C++
# ═══════════════════════════════════════════════════════════════════════════

FROM debian:bookworm-slim

LABEL org.shieldai.version="2.0"
LABEL org.shieldai.module="sandbox-base"
LABEL org.shieldai.description="Isolated execution environment with full deception layer"

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PATH=/usr/local/go/bin:/root/.cargo/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# ───────────────────────────────────────────────────────────────────────────
# 1. OUTILS SYSTÈME DE BASE (groupés pour réduire les couches)
# ───────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget ca-certificates gnupg apt-transport-https \
    build-essential gcc g++ cmake make \
    git unzip zip vim-tiny jq tree \
    openssl sudo procps lsof psmisc \
    net-tools iproute2 netcat-openbsd iputils-ping \
    file binutils xxd \
    libseccomp-dev libcap2-bin \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ───────────────────────────────────────────────────────────────────────────
# 2. PYTHON 3.11 + pip + pipenv + poetry
# ───────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3-pip python3.11-venv python3.11-dev \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && pip install --no-cache-dir --break-system-packages --timeout 300 pipenv poetry \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ───────────────────────────────────────────────────────────────────────────
# 3. NODE.JS 20 + npm + yarn + pnpm
# ───────────────────────────────────────────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g yarn pnpm \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ───────────────────────────────────────────────────────────────────────────
# 4. PHP 8.2 + composer
# ───────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    php8.2-cli php8.2-common php8.2-curl php8.2-mbstring \
    php8.2-xml php8.2-zip php8.2-bcmath \
    && curl -sS --max-time 300 https://getcomposer.org/installer | php \
    && mv composer.phar /usr/local/bin/composer \
    && chmod +x /usr/local/bin/composer \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ───────────────────────────────────────────────────────────────────────────
# 5. RUBY 3 + gem + bundler
# ───────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ruby ruby-dev ruby-bundler \
    && gem install bundler --no-document \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ───────────────────────────────────────────────────────────────────────────
# 6. PERL 5 + cpanminus
# ───────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    perl cpanminus \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ───────────────────────────────────────────────────────────────────────────
# 7. JAVA 21 JDK + maven + gradle (CORRIGÉ : openjdk-21-jdk au lieu de openjdk-21-jdk-headless)
# ───────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jdk maven \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# ───────────────────────────────────────────────────────────────────────────
# 8. GO 1.22
# ───────────────────────────────────────────────────────────────────────────
RUN curl -OL --max-time 300 https://go.dev/dl/go1.22.4.linux-amd64.tar.gz \
    && tar -C /usr/local -xzf go1.22.4.linux-amd64.tar.gz \
    && rm go1.22.4.linux-amd64.tar.gz

ENV GOPATH=/home/sandbox/go

# ───────────────────────────────────────────────────────────────────────────
# 9. RUST + cargo
# ───────────────────────────────────────────────────────────────────────────
RUN curl --proto '=https' --tlsv1.2 -sSf --max-time 300 https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --no-modify-path

ENV PATH=/root/.cargo/bin:$PATH

# ───────────────────────────────────────────────────────────────────────────
# 10. LUA 5.4 + luarocks
# ───────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    lua5.4 luarocks \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ───────────────────────────────────────────────────────────────────────────
# 11. R + Rscript
# ───────────────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    r-base \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ───────────────────────────────────────────────────────────────────────────
# 12. POWERSHELL CORE
# ───────────────────────────────────────────────────────────────────────────
RUN wget -q --timeout=300 https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb \
    && dpkg -i packages-microsoft-prod.deb \
    && apt-get update \
    && apt-get install -y powershell \
    && rm packages-microsoft-prod.deb \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ───────────────────────────────────────────────────────────────────────────
# 13. UTILISATEURS — système multi-comptes crédible (groupés en une seule couche)
# ───────────────────────────────────────────────────────────────────────────
RUN useradd -m -s /bin/bash -u 1000 -c "DevOps Engineer" devops \
    && echo "devops:$(openssl rand -hex 20)" | chpasswd \
    && usermod -aG sudo devops \
    && useradd -m -s /bin/bash -u 1001 -c "Deploy User" deploy \
    && echo "deploy:$(openssl rand -hex 20)" | chpasswd \
    && useradd -m -s /usr/sbin/nologin -u 1002 -c "Web Application Service" appservice \
    && useradd -m -s /usr/sbin/nologin -u 1003 -c "Database Service" dbadmin \
    && useradd -m -s /usr/sbin/nologin -u 1004 -c "Monitoring Agent" monitor \
    && useradd -m -s /bin/bash -u 1500 -c "Sandbox Execution User" sandbox \
    && echo "sandbox:$(openssl rand -hex 20)" | chpasswd

# ───────────────────────────────────────────────────────────────────────────
# 14. /etc — fichiers système crédibles (groupés pour réduire les RUN)
# ───────────────────────────────────────────────────────────────────────────
RUN cat > /etc/passwd << 'PASSWDEOF'
root:x:0:0:root:/root:/bin/bash
daemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin
bin:x:2:2:bin:/bin:/usr/sbin/nologin
sys:x:3:3:sys:/dev:/usr/sbin/nologin
sync:x:4:65534:sync:/bin:/bin/sync
games:x:5:60:games:/usr/games:/usr/sbin/nologin
man:x:6:12:man:/var/cache/man:/usr/sbin/nologin
lp:x:7:7:lp:/var/spool/lpd:/usr/sbin/nologin
mail:x:8:8:mail:/var/mail:/usr/sbin/nologin
news:x:9:9:news:/var/spool/news:/usr/sbin/nologin
uucp:x:10:10:uucp:/var/spool/uucp:/usr/sbin/nologin
proxy:x:13:13:proxy:/bin:/usr/sbin/nologin
www-data:x:33:33:www-data:/var/www:/usr/sbin/nologin
backup:x:34:34:backup:/var/backups:/usr/sbin/nologin
list:x:38:38:Mailing List Manager:/var/list:/usr/sbin/nologin
irc:x:39:39:ircd:/run/ircd:/usr/sbin/nologin
nobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin
systemd-network:x:998:998:systemd Network Management:/:/usr/sbin/nologin
systemd-resolve:x:997:997:systemd Resolver:/:/usr/sbin/nologin
messagebus:x:100:107::/nonexistent:/usr/sbin/nologin
sshd:x:101:65534::/run/sshd:/usr/sbin/nologin
mysql:x:102:102:MySQL Server:/var/lib/mysql:/usr/sbin/nologin
redis:x:103:103:Redis Server:/var/lib/redis:/usr/sbin/nologin
nginx:x:104:104:nginx user:/var/cache/nginx:/usr/sbin/nologin
devops:x:1000:1000:DevOps Engineer,,,:/home/devops:/bin/bash
deploy:x:1001:1001:Deploy User,,,:/home/deploy:/bin/bash
appservice:x:1002:1002:Web Application Service:/home/appservice:/usr/sbin/nologin
dbadmin:x:1003:1003:Database Service:/home/dbadmin:/usr/sbin/nologin
monitor:x:1004:1004:Monitoring Agent:/home/monitor:/usr/sbin/nologin
sandbox:x:1500:1500:Sandbox Execution User:/home/sandbox:/bin/bash
PASSWDEOF

RUN cat > /etc/shadow << 'SHADOWEOF'
root:!:19800:0:99999:7:::
daemon:*:19800:0:99999:7:::
bin:*:19800:0:99999:7:::
