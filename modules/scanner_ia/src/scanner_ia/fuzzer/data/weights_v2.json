  "scoring_algorithm": {
    "description": "Comment calculer le score final de détection",
    "steps": [
      "1. Récupérer weights pour la vulnérabilité",
      "2. Calculer score composants (indicators, status, delay, headers, body)",
      "3. Score total = sum(weight[i] * component_score[i])",
      "4. Normaliser entre 0-100: normalize(score, c=50)",
      "5. Calculer confiance: sigmoid(normalized/100, center=0.5, k=8)",
      "6. Décision: confiance >= 0.8 → vulnérabilité détectée"
    ],
    "formulas": {
      "normalize": "score / (1 + abs(score - c))",
      "sigmoid": "1 / (1 + exp(-k * (x - center)))"
    }
  },
  "usage_example": {
    "python_code": "# Charger weights\nwith open('weights_v2.json') as f:\n    config = json.load(f)\n\n# Récupérer weights pour XSS\nvuln_type = 'xss'\nweights = config['vulnerability_weights'][vuln_type]['weights']\n# weights = [0.60, 0.15, 0.00, 0.20, 0.05]\n\n# Calculer score\ncomponent_scores = [0.8, 0.5, 0.0, 0.3, 0.1]  # Exemple\ntotal_score = sum(w * s for w, s in zip(weights, component_scores))\n# total_score = 0.60*0.8 + 0.15*0.5 + 0.00*0.0 + 0.20*0.3 + 0.05*0.1 = 0.61\n\n# Normaliser et décider\nnormalized = normalize(total_score, c=0.5)\nconfidence = sigmoid(normalized)\nif confidence >= 0.8:\n    print(f'Vulnérabilité {vuln_type} détectée avec confiance {confidence:.2%}')"
  }
