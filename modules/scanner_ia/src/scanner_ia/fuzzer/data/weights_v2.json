    "status_code": {
      "description": "Status HTTP (200, 302, 403, 500, etc.)",
      "importance": "Critique pour auth, permissions, errors"
    },
    "delay": {
      "description": "Temps de réponse (pour SQLi time-based, DoS, race conditions)",
      "importance": "Critique seulement pour attaques time-based"
    },
    "headers": {
      "description": "Headers HTTP (CORS, Set-Cookie, CSP, etc.)",
      "importance": "Critique pour CORS, cookies, crypto"
    },
    "body_size": {
      "description": "Taille de la réponse",
      "importance": "Généralement faible sauf exceptions"
    }
